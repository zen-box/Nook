    "At least 8 characters. Nook can't recover a forgotten master password: without it the vault can only be reset.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 8 个字符。主密码忘记后无法找回，只能重置密码库。"
          }
        }
      }
    },
