        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加有具体时间的日程并选择提醒，即可接收通知。"
          }
        }
      }
    },
    "Add expenses, notes, tasks, events and anniversaries. Review changes before saving. The vault is never accessible.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记账、写便签、安排任务、日程和纪念日。修改会先交给你核对，密码库不会提供给 AI。"
          }
        }
      }
    },
    "Add item": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
