        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看全部"
          }
        }
      }
    },
    "Waiting for confirmation on the other phone…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待另一台手机确认…"
          }
        }
      }
    },
    "Waiting for the new phone to confirm its import…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待新手机确认导入…"
          }
        }
