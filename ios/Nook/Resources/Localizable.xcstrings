    "Add expenses, notes, tasks, events and anniversaries. Review changes before saving. The vault is never accessible.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add expenses, notes, tasks, events and anniversaries. Review changes before saving. The vault is never accessible."
