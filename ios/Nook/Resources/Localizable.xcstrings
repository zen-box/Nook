    },
    "All-day events don't send reminders. Choose a start time to receive a notification.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全天日程暂不发送提醒。请选择具体时间以接收通知。"
          }
        }
      }
    },
    "Allow camera access in Settings, or enter the pairing code manually.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许相机访问，或手动输入配对码。"
