          }
        }
      }
    },
    "Without the master password the saved items can't be decrypted. Resetting deletes them and lets you choose a new master password.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the master password the saved items can't be decrypted. Resetting deletes them and lets you choose a new master password."
          }
