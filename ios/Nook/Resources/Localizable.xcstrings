    "Website": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站"
          }
        }
      }
    },
    "Weekdays": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作日（周一至周五）"
          }
        }
      }
    },
    "Weekly": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周"
          }
        }
      }
    },
    "What would you like to do?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想处理什么事情？"
          }
        }
      }
    },
    "What's the plan?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有什么安排？"
          }
        }
      }
    },
    "Widget data could not be updated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组件数据暂时无法更新。"
          }
        }
      }
    },
    "Widget sharing is unavailable. The re-signed app and widget need matching App Groups entitlements.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前无法共享小组件数据。重签后的主 App 与小组件需要匹配的 App Groups 权限。"
          }
        }
      }
    },
    "Widgets": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组件"
          }
        }
      }
    },
    "Widgets share only schedule and task summaries. Passwords, keys and note contents are never shared.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组件仅共享日程、任务和纪念日摘要，不共享密码、密钥或便签正文。"
          }
        }
      }
    },
    "Without the master password the saved items can't be decrypted. Resetting deletes them and lets you choose a new master password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有主密码就无法解密已保存的内容。重置会删除这些内容，之后可以设置新的主密码。"
          }
        }
      }
    },
    "Work": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作"
          }
        }
      }
    },
    "Working on your request…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理…"
          }
        }
      }
    },
    "Works locally without a server. S3 stores encrypted data and history. Automatic sync runs while Nook is active; open Nook to finish pending uploads before changing phones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机功能无需服务器。S3 保存加密数据与历史版本；Nook 处于活跃状态时自动同步，换手机前请打开 App 完成待上传内容。"
          }
        }
      }
    },
    "Write something…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写点什么…"
          }
        }
      }
    },
    "Write your first note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下第一条便签"
          }
        }
      }
    },
    "Wrong master password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主密码不正确。"
          }
        }
      }
    },
    "Yearly": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每年"
          }
        }
      }
    },
    "Yes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是"
          }
        }
      }
    },
    "You can still enter the model ID manually.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你仍可手动输入模型 ID。"
          }
        }
      }
    },
    "Your accounts and passwords are encrypted and safe.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账号和密码经过加密，安全可靠。"
          }
        }
      }
    },
    "Your name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的名字"
          }
        }
      }
    },
    "Your next event and tasks. Details are hidden until you enable them in Nook.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看日程与任务，详细内容需在 Nook 中主动开启显示。"
          }
        }
      }
    },
    "Your selected text and images are sent directly to this API. The vault is never available to the assistant. API keys stay in this device's Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所需文字和你选中的图片会直接发送给此 API；助手无法访问密码库。API 密钥仅保存在本机钥匙串中。"
          }
        }
      }
    },
